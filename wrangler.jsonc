{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sift-app",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "triggers": { "crons": ["0 * * * *"] },
  "vars": { "RATE_LIMIT_EDGE_ENABLED": "true", "EMAIL_REMINDER_DAYS_BEFORE": "1" },
  "assets": { "directory": "dist/client" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sift-production",
      "database_id": "fa487f7a-ecfb-4968-8820-1214dd736e3c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "AUTH_EDGE_LIMITER", "namespace_id": "128001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ANALYZE_EDGE_LIMITER", "namespace_id": "128002", "simple": { "limit": 600, "period": 60 } }
  ],
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ]
}
