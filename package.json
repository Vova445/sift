{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/wrap-worker-entry.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern test-results --ignore-pattern playwright-report",
    "test": "node --experimental-test-coverage --test-coverage-include=lib/analyzer-core.js --test-coverage-include=lib/entitlement-policy.js --test-coverage-include=lib/plan-catalog.js --test-coverage-include=lib/request-rate-limit-policy.js --test-coverage-include=lib/scan-quota-policy.js --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test tests/*.test.mjs",
    "eval:analyzer": "node scripts/evaluate-analyzer.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium && playwright install chromium-headless-shell",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:billing": "node --test tests/subscription-lifecycle.test.mjs tests/billing-event-key.test.mjs tests/billing-security.test.mjs",
    "test:ai-cost": "node --test tests/ai-cost-policy.test.mjs",
    "test:email-verification": "node --test tests/email-verification-policy.test.mjs",
    "test:email-reminders": "node --test tests/email-reminder-policy.test.mjs",
    "test:password-security": "node --test tests/password-security-policy.test.mjs",
    "test:account-data": "node --test tests/account-data-export.test.mjs",
    "test:ssrf": "node --test tests/ssrf-protection.test.mjs",
    "test:rate-limit": "node --test tests/request-rate-limit-policy.test.mjs",
    "test:turnstile": "node --test tests/turnstile-policy.test.mjs",
    "test:legal": "node --test tests/legal-consent-policy.test.mjs",
    "verify:rate-limit:local": "node scripts/verify-rate-limit-local.mjs",
    "verify:analyze-rate-limit:local": "node scripts/verify-analyze-rate-limit-local.mjs",
    "verify:turnstile:local": "node scripts/verify-turnstile-routes-local.mjs",
    "verify:account-data:local": "node scripts/verify-account-data-local.mjs",
    "test:entitlements": "node --test tests/entitlements.test.mjs",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:monitoring": "node --test tests/worker-monitoring.test.mjs",
    "test:backup": "node --test tests/d1-backup.test.mjs",
    "verify:backup-restore": "node scripts/verify-d1-backup-restore.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
