# Copy to .dev.vars for local sandbox testing. These are WayForPay's published test merchant details.
WAYFORPAY_MODE=sandbox
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_MERCHANT_SECRET=flk3409refn54t54t*FNJRET
WAYFORPAY_MERCHANT_PASSWORD=
WAYFORPAY_MERCHANT_DOMAIN=127.0.0.1
APP_BASE_URL=http://127.0.0.1:8788
RATE_LIMIT_EDGE_ENABLED=false
WAYFORPAY_SANDBOX_ALLOWLIST=replace-with-your-test-account-email
RESEND_API_KEY=
AUTH_EMAIL_FROM=
DUNNING_FROM_EMAIL=
EMAIL_REMINDER_DAYS_BEFORE=1
DUNNING_CRON_SECRET=replace-with-a-long-random-secret
# Domain must be verified and have Cloudflare Email Routing enabled.
EMAIL_RADAR_DOMAIN=
AI_RADAR_ENABLED=true
AI_RADAR_MAX_EMAIL_CHARS=12000
D1_REST_API_TOKEN=replace-with-a-least-privilege-cloudflare-api-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-secret
TELEGRAM_CHAT_ID=
UPTIME_PING_URL=
ANALYTICS_ADMIN_EMAIL=replace-with-your-admin-email
SUPPORT_ADMIN_EMAILS=replace-with-one-or-more-comma-separated-admin-emails
MONITORING_TEST_TOKEN=
AI_TRANSLATION_ENABLED=true
AI_DAILY_REQUEST_LIMIT=500
AI_DAILY_TOKEN_LIMIT=100000
AI_MAX_TRANSLATION_CHARS=8000
TURNSTILE_SITE_KEY=replace-with-your-cloudflare-turnstile-sitekey
TURNSTILE_SECRET_KEY=replace-with-your-cloudflare-turnstile-secret
REFERRAL_ABUSE_SECRET=replace-with-a-dedicated-random-32-character-secret
